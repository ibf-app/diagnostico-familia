# Postgres no Railway
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""

# Precisa ser um remetente verificado em https://app.brevo.com/senders
BREVO_SENDER_EMAIL="send@edudebarros.com.br"

# URL pública onde o app está hospedado — usada para montar links absolutos
# (ex.: o logo embutido no e-mail). Trocar quando tivermos domínio próprio.
APP_BASE_URL="https://diagnostico-familia-production.up.railway.app"

# Token usado pelo agendador externo (Railway cron service ou cron-job.org) pra
# autenticar em POST /api/cron/reprocessar-falhas e POST /api/cron/expurgar-leads
# via header "Authorization: Bearer <CRON_SECRET>". Gere um valor aleatório forte.
CRON_SECRET=""
